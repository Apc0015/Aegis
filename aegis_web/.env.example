# Aegis web client environment
# Copy to .env.local for local overrides.

# Base URL of the Aegis FastAPI backend.
# In dev, leave empty to use the Vite proxy (/api -> VITE_API_PROXY_TARGET).
# In production, set to the full backend origin, e.g. https://api.aegis.example.com
VITE_API_BASE=

# Dev-only: where the Vite proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000
