# ── Cloud LLM ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-v1-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GOOGLE_API_KEY=...
AZURE_OPENAI_API_KEY=...
COHERE_API_KEY=...

# ── Login credentials ─────────────────────────────────────────────────
RAPID_USERNAME=username
RAPID_PASSWORD=password

# ── Local AI (optional) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model

# ── Provider base URL overrides (optional) ───────────────────────────
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AZURE_OPENAI_BASE_URL=
COHERE_BASE_URL=https://api.cohere.com/v2

# ── Runtime model overrides (optional) ───────────────────────────────
# When set, these override config.yaml values.
RAPID_CONFIG_PATH=config.yaml
RAPID_PRIVACY_MODE=cloud
RAPID_DOMAIN=general

RAPID_MAIN_PROVIDER=openai
RAPID_MAIN_MODEL=gpt-4o
RAPID_MAIN_TEMPERATURE=0.7
RAPID_MAIN_MAX_TOKENS=2000
RAPID_MAIN_API_KEY=
RAPID_MAIN_BASE_URL=

RAPID_EVALUATOR_PROVIDER=openai
RAPID_EVALUATOR_MODEL=gpt-4o-mini
RAPID_EVALUATOR_TEMPERATURE=0.0
RAPID_EVALUATOR_MAX_TOKENS=1000
RAPID_EVALUATOR_API_KEY=
RAPID_EVALUATOR_BASE_URL=

RAPID_EMBED_PROVIDER=openai
RAPID_EMBED_MODEL=text-embedding-3-small
RAPID_EMBED_API_KEY=
RAPID_EMBED_BASE_URL=
