# ── Aegis Environment Variables ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported: openai | anthropic | ollama | openrouter | groq | google | lm_studio
AEGIS_LLM_PROVIDER=openrouter
AEGIS_MAIN_MODEL=meta-llama/llama-3.3-70b-instruct:free

# API key for the chosen provider
AEGIS_MAIN_API_KEY=

# Provider-specific keys (used automatically if AEGIS_MAIN_API_KEY is not set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ── Embeddings ─────────────────────────────────────────────────────────────────
# Supported: openai | ollama | local (sentence-transformers, no key needed)
AEGIS_EMBED_PROVIDER=local

# ── Cross-model Evaluator (optional) ──────────────────────────────────────────
# AEGIS_EVALUATOR_PROVIDER=openai
# AEGIS_EVALUATOR_MODEL=gpt-4o-mini
# AEGIS_EVALUATOR_API_KEY=

# ── Auth ───────────────────────────────────────────────────────────────────────
AEGIS_JWT_SECRET=change-me-to-a-random-32-char-secret-in-production
# username:role:password[:employee_id]  (roles: admin | manager | employee)
# employee_id (optional 4th field) links the login to an HR-database
# employees.employee_id so row-level security can match "own records".
AEGIS_USERS=admin:admin:admin123,alice:manager:alice123:EMP0001,bob:employee:bob123:EMP0042

# Per-user query rate limit (queries/minute, 0 disables)
# AEGIS_RATE_LIMIT_PER_MINUTE=30
# LLM call timeout (seconds) and transient-error retries
# AEGIS_LLM_TIMEOUT_SECONDS=60
# AEGIS_LLM_RETRIES=1
# End-to-end query timeout (seconds)
# AEGIS_QUERY_TIMEOUT_SECONDS=120

# ── Database ───────────────────────────────────────────────────────────────────
# DB type: sqlite | postgres | mysql
AEGIS_DB_TYPE=sqlite

# SQLite: path to your .db file
AEGIS_DB_PATH=data/medical_company.db

# Postgres / MySQL: full connection URL
# AEGIS_DB_URL=postgresql://user:password@localhost:5432/mydb
# AEGIS_DB_URL=mysql+pymysql://user:password@localhost:3306/mydb

# ── Task Queue (optional — for async document ingestion) ────────────────────
# ARQ uses Redis. Install: pip install arq redis
# Run worker: arq aegis.tasks.worker.WorkerSettings
# AEGIS_REDIS_URL=redis://localhost:6379

# ── Connectors ─────────────────────────────────────────────────────────────────
# Google (Gmail + Drive)
# AEGIS_GOOGLE_CLIENT_ID=
# AEGIS_GOOGLE_CLIENT_SECRET=
# Microsoft (OneDrive + SharePoint)
# AEGIS_MICROSOFT_CLIENT_ID=
# AEGIS_MICROSOFT_TENANT_ID=common
# Slack
# AEGIS_SLACK_BOT_TOKEN=xoxb-...

# ── Feature Flags ──────────────────────────────────────────────────────────────
AEGIS_WEB_ENABLED=true

# ── Server ─────────────────────────────────────────────────────────────────────
AEGIS_ENV=development
# AEGIS_CORS_ORIGINS=https://yourapp.com,https://app.yourcompany.com
AEGIS_LOG_LEVEL=INFO
