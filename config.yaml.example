# RAPID runtime model configuration
#
# Copy this file to config.yaml and edit provider/model values as needed.
# Environment variables (RAPID_* keys) can override any field.

rag_system:
  main_llm:
    provider: "openai"         # openai | anthropic | ollama | groq | google | azure | openrouter | lm_studio
    model: "gpt-4o"
    temperature: 0.7
    max_tokens: 2000

  evaluator_llm:
    provider: "openai"         # must use a different model than main_llm
    model: "gpt-4o-mini"
    temperature: 0.0
    max_tokens: 1000

  embeddings:
    provider: "openai"         # openai | ollama | cohere | google | azure
    model: "text-embedding-3-small"

privacy_mode: "cloud"          # cloud | local | hybrid
domain: "legal"                # general | legal | hr_policy | technical | ...


