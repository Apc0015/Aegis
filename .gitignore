# The curated demo prototypes (example/hr/medical_evaluation) stay tracked.
data/domain_prototypes/test_*.json
data/domain_prototypes/*session*.json

# Agent memory is source-controlled (intentional YAML scaffolds)
# data/agent_memory/  ← NOT gitignored

